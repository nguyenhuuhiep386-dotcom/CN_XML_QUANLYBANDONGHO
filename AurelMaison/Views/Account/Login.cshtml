@model DangNhapForm
@{
    ViewData["Title"] = "Đăng nhập";
    var skipRitual = string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase);
}
<section class="login-stage" id="login-stage" data-skip="@(skipRitual ? "true" : "false")" aria-labelledby="ritual-title">
    <div class="ritual-copy">
        <p class="kicker">AUREL MAISON · PRIVATE ACCESS</p>
        <h1 id="ritual-title">Mỗi khoảnh khắc<br /><em>đều có khởi đầu.</em></h1>
        <p>Kéo quả nặng dưới đồng hồ để bước vào không gian của riêng bạn.</p>
    </div>
    <div class="ritual-scene">
        <div class="ritual-clock" aria-label="Đồng hồ bỏ túi lộ cơ với dây xích kéo ở dưới">
            <svg class="skeleton-watch" viewBox="0 0 360 380" role="img" aria-label="Mặt đồng hồ lộ cơ">
                <defs>
                    <radialGradient id="watch-face-gradient"><stop stop-color="#284032"/><stop offset=".72" stop-color="#0a1b13"/><stop offset="1" stop-color="#030907"/></radialGradient>
                    <linearGradient id="watch-metal-gradient" x2="1" y2="1"><stop stop-color="#f0d3a1"/><stop offset=".3" stop-color="#886940"/><stop offset=".62" stop-color="#d3ad77"/><stop offset="1" stop-color="#5b4025"/></linearGradient>
                    <radialGradient id="watch-glass-gradient"><stop stop-color="#d9b878" stop-opacity=".08"/><stop offset=".75" stop-color="#f5e7c6" stop-opacity=".01"/><stop offset="1" stop-color="#f5e7c6" stop-opacity=".1"/></radialGradient>
                </defs>
                <circle cx="180" cy="26" r="15" fill="none" stroke="url(#watch-metal-gradient)" stroke-width="8"/>
                <rect x="166" y="34" width="28" height="18" rx="5" fill="url(#watch-metal-gradient)"/>
                <circle cx="180" cy="202" r="146" fill="#0a130e" stroke="url(#watch-metal-gradient)" stroke-width="13"/>
                <circle cx="180" cy="202" r="128" fill="url(#watch-face-gradient)" stroke="#b3905f" stroke-width="2"/>
                <g class="skeleton-gears">
                    <g transform="translate(140 222)"><g class="skeleton-gear gear-a"><circle r="36" fill="none" stroke="url(#watch-metal-gradient)" stroke-width="7" stroke-dasharray="7 7"/><circle r="27" fill="none" stroke="url(#watch-metal-gradient)" stroke-width="3"/><path d="M-26 0H26M0-26V26M-18-18L18 18M18-18L-18 18" stroke="url(#watch-metal-gradient)" stroke-width="1.6"/><circle r="8" fill="#0a160f" stroke="#d3ad77" stroke-width="2"/></g></g>
                    <g transform="translate(193 192)"><g class="skeleton-gear gear-b"><circle r="24" fill="none" stroke="url(#watch-metal-gradient)" stroke-width="5" stroke-dasharray="6.2 6.2"/><circle r="17" fill="none" stroke="url(#watch-metal-gradient)" stroke-width="2"/><path d="M-17 0H17M0-17V17M-12-12L12 12M12-12L-12 12" stroke="url(#watch-metal-gradient)" stroke-width="1.3"/><circle r="5" fill="#0a160f" stroke="#d3ad77" stroke-width="1.5"/></g></g>
                    <circle cx="180" cy="202" r="11" fill="#b08b57" stroke="#e0bd89" stroke-width="3"/>
                </g>
                <circle cx="180" cy="202" r="123" fill="url(#watch-glass-gradient)" stroke="#e4ca98" stroke-opacity=".35"/>
                <g class="skeleton-indices" fill="#d4b47d" font-family="Georgia,serif" font-size="20" text-anchor="middle"><text x="180" y="108">XII</text><text x="278" y="210">III</text><text x="180" y="307">VI</text><text x="82" y="210">IX</text></g>
                <g class="skeleton-hands"><line class="watch-hour-hand" x1="180" y1="216" x2="180" y2="146"/><line class="watch-minute-hand" x1="180" y1="221" x2="180" y2="121"/><line class="watch-second-hand" x1="180" y1="229" x2="180" y2="112"/><circle cx="180" cy="202" r="7" fill="#e5c18a" stroke="#593e24" stroke-width="2"/></g>
            </svg>
            <button class="ritual-cord" id="ritual-cord" type="button" aria-label="Kéo quả nặng dưới đồng hồ để mở hoặc đóng trang đăng nhập" aria-describedby="ritual-instruction"><span class="ritual-cord-line"></span><span class="ritual-cord-handle"></span></button>
        </div>
        <p id="ritual-instruction" class="ritual-instruction">KÉO DÂY ĐỂ LÊN CÓT</p>
    </div>
    <div class="auth-form login-glass-card" id="login-form-panel">
        <p class="kicker">KHÔNG GIAN CÁ NHÂN</p><h2>Đăng nhập</h2><p class="auth-intro">Đăng nhập để tiếp tục trải nghiệm cùng Aurel Maison.</p>
        <form asp-action="Login" method="post" class="stack">
            <div asp-validation-summary="All" class="validation"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label>Email<input class="aurel-input" asp-for="Email" placeholder="email@example.com" autocomplete="email" /></label>
            <label>Mật khẩu<input class="aurel-input" asp-for="MatKhau" placeholder="Nhập mật khẩu của bạn" autocomplete="current-password" /></label>
            <button>Đăng nhập <partial name="_Icon" model='@("arrow")' /></button>
        </form>
        <p class="auth-switch">Bạn chưa có tài khoản? <a asp-action="Register">Tạo tài khoản</a></p>
    </div>
    <p class="ritual-status sr-only" id="ritual-status" role="status"></p>
</section>
@section Scripts {
    <script src="~/js/login-ritual.js" asp-append-version="true"></script>
}
