@model string
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
@switch (Model)
{
    case "bag":
        <path d="M5 7h14l1 14H4L5 7Z" /><path d="M8 8V6a4 4 0 0 1 8 0v2" />
        break;
    case "user":
        <circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" />
        break;
    case "search":
        <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" />
        break;
    case "arrow":
        <path d="M4 12h16m-6-6 6 6-6 6" />
        break;
    case "calendar":
        <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 10h18m-13 5h3m3 0h2" />
        break;
    case "check":
        <path d="m5 12 4 4L19 6" /><circle cx="12" cy="12" r="10" />
        break;
    case "shield":
        <path d="m12 2 8 3v6c0 5-8 11-8 11S4 16 4 11V5l8-3Z" /><path d="m8 11 3 3 5-5" />
        break;
    case "clock":
        <circle cx="12" cy="12" r="9" /><path d="M12 6v6l4 2" />
        break;
    case "logout":
        <path d="M9 4H4v16h5m5-13 5 5-5 5m-7-5h12" />
        break;
    case "menu":
        <path d="M4 6h16M4 12h16M4 18h16" />
        break;
    case "close":
        <path d="m6 6 12 12M18 6 6 18" />
        break;
    default:
        <circle cx="12" cy="12" r="9" /><path d="M12 8v5m0 3h.01" />
        break;
}
</svg>
