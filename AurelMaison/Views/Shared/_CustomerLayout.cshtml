@inject GioHangService GioHang
@{
    var soLuong = GioHang.Lay(Context.Session).Sum(x => x.SoLuong);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isCustomer = User.IsInRole(Security.Customer);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183a30" />
    <title>@ViewData["Title"] | Aurel Maison</title>
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <script src="~/js/customer.js" asp-append-version="true" defer></script>
</head>
<body class="customer page-@controller.ToLowerInvariant() action-@action.ToLowerInvariant()">
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<div class="announcement" hidden><span>AUREL MAISON · WATCH BOUTIQUE</span><span>Showroom Đà Nẵng <b>·</b> 09:00–20:00</span></div>
<header class="top">
    <div class="wrap nav">
        <a class="logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Aurel Maison — Trang chủ">
            <span class="brand-mark">AM</span><span>AUREL MAISON<small>THE WATCH COLLECTION</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-controls="customer-nav" aria-expanded="false" aria-label="Mở menu">
            <partial name="_Icon" model='@("menu")' />
        </button>
        <nav id="customer-nav" class="primary-nav" aria-label="Menu chính">
            <a class="@(controller == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a class="@(controller == "DanhMuc" ? "active" : "")" asp-area="" asp-controller="DanhMuc" asp-action="Index">Bộ sưu tập</a>
            <a class="@(controller == "Booking" ? "active" : "")" asp-area="" asp-controller="Booking" asp-action="Index">Đặt lịch</a>
            <a class="@(controller == "Warranty" ? "active" : "")" asp-area="" asp-controller="Warranty" asp-action="Index">Bảo hành</a>
        </nav>
        <div class="header-actions">
            <a class="account-link" asp-area="" asp-controller="Account" asp-action="@(isCustomer ? "Index" : "Login")">
                <partial name="_Icon" model='@("user")' /><span>@(isCustomer ? "Tài khoản" : "Đăng nhập")</span>
            </a>
            <a class="bag" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng có @soLuong sản phẩm">
                <partial name="_Icon" model='@("bag")' />
                @if (soLuong > 0) { <span class="cart-count">@soLuong</span> }
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form class="header-logout" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button class="quiet" type="submit" aria-label="Đăng xuất" title="Đăng xuất"><partial name="_Icon" model='@("logout")' /></button>
                </form>
            }
        </div>
    </div>
</header>
<main id="main-content" class="wrap main">
    @if (TempData["Message"] is string message)
    { <p class="notice" role="status"><partial name="_Icon" model='@("check")' />@message</p> }
    @if (TempData["Error"] is string error)
    { <p class="notice error" role="alert"><partial name="_Icon" model='@("info")' />@error</p> }
    @RenderBody()
</main>
<footer class="foot">
    <div class="wrap footer-main">
        <div class="footer-brand"><a class="logo" asp-area="" asp-controller="Home" asp-action="Index">AUREL MAISON</a><p>Khám phá đồng hồ.<br />Tìm dấu ấn của riêng bạn.</p></div>
        <div><h2>Khám phá</h2><a asp-area="" asp-controller="DanhMuc" asp-action="Index">Bộ sưu tập đồng hồ</a><a asp-area="" asp-controller="Booking" asp-action="Index">Đặt lịch tại showroom</a></div>
        <div><h2>Dịch vụ khách hàng</h2><a asp-area="" asp-controller="Order" asp-action="Tracking">Đơn hàng của tôi</a><a asp-area="" asp-controller="Warranty" asp-action="Index">Tra cứu bảo hành</a><a asp-area="" asp-controller="Account" asp-action="Index">Tài khoản của tôi</a></div>
        <div><h2>Ghé thăm showroom</h2><p>Showroom Đà Nẵng<br />Hằng ngày · 09:00–20:00</p><a asp-area="" asp-controller="Booking" asp-action="Index">Hẹn gặp tại showroom →</a></div>
    </div>
    <div class="wrap footer-bottom"><span>© @Rules.Now.Year Aurel Maison</span><a asp-area="" asp-controller="DanhMuc" asp-action="Xml">Xem danh mục HTML</a><span>Thời gian được trân trọng.</span></div>
</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
