@model GioVm
@{
    ViewData["Title"] = "Khay thử";
    var mauQuanTam = string.Join(", ", Model.Dong.Select(x => x.TenMau));
}
<nav class="breadcrumb" aria-label="Đường dẫn"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>/</span><span>Khay thử</span></nav>
<header class="page-heading"><div><p class="kicker">AUREL MAISON · PRIVATE LOUNGE</p><h1>Khay thử của bạn</h1><p>Lưu những thiết kế bạn muốn cảm nhận trực tiếp tại showroom.</p></div><a class="text-link" asp-controller="DanhMuc" asp-action="Index">Tiếp tục khám phá →</a></header>
@if (Model.Dong.Count == 0)
{
    <section class="empty-state tray-empty"><partial name="_Icon" model='@("tray")' /><p class="kicker">VELVET PRESENTATION TRAY</p><h2>Khay thử đang chờ những lựa chọn đầu tiên</h2><p>Thêm các mẫu bạn yêu thích, rồi chọn giờ hẹn và thức uống tại Private Lounge Đà Nẵng.</p><a class="button" asp-controller="DanhMuc" asp-action="Index">Khám phá bộ sưu tập</a></section>
}
else
{
    <div class="checkout-layout tray-layout">
        <section class="panel cart-items tray-items" aria-label="Đồng hồ trong khay thử">
        @foreach (var item in Model.Dong)
        {
            <article class="cartline tray-line">
                <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "/images/watch.svg" : item.HinhAnh)" alt="@item.TenMau" />
                <div><p class="kicker">REF. @item.MaMau</p><h2>@item.TenMau</h2><p class="tray-price">@Rules.Money(item.Gia)</p>
                    @if (!item.DangBan || item.SoLuong > item.SoConHang)
                    { <p class="validation">Sản phẩm không đủ hàng. Hiện còn @item.SoConHang chiếc.</p> }
                </div>
                <div class="actions">
                    @if (item.DangBan && item.SoConHang > 0)
                    {
                        <form asp-action="CapNhat" method="post" class="actions">
                            <input type="hidden" name="maMau" value="@item.MaMau" />
                            <label>Số lượng<input class="qty" name="soLuong" type="number" min="1" max="@item.SoConHang" value="@item.SoLuong" required /></label>
                            <button class="outline">Cập nhật</button>
                        </form>
                    }
                    <form asp-action="Xoa" method="post"><input type="hidden" name="maMau" value="@item.MaMau" /><button class="quiet">Bỏ khỏi khay</button></form>
                </div>
            </article>
        }
        </section>
        <aside class="panel summary tray-summary">
            <p class="kicker">PRIVATE LOUNGE · ĐÀ NẴNG</p><h2>Chuẩn bị buổi thử</h2>
            <p class="tray-summary-copy">Chúng tôi sẽ chuẩn bị các mẫu trong khay cho buổi hẹn riêng của bạn.</p>
            <div class="summary-row"><span>Mẫu đã chọn</span><strong>@Model.Dong.Count mẫu</strong></div>
            @if (Model.HopLe)
            {
                <a class="button" asp-controller="Booking" asp-action="Index" asp-route-maMau="@Model.Dong[0].MaMau" asp-route-mauQuanTam="@mauQuanTam">Chọn giờ & thức uống <partial name="_Icon" model='@("calendar")' /></a>
                <a class="text-link tray-online-link" asp-controller="Order" asp-action="Checkout">Hoặc đặt mua trực tuyến</a>
            }
            else { <p class="validation">Cập nhật lựa chọn còn hàng để tiếp tục.</p> }
        </aside>
    </div>
}
