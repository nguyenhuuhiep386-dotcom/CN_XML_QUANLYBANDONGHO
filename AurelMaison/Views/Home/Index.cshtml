@model TrangChuVm
@{ ViewData["Title"] = "Trang chủ"; }
<section class="hero">
    <div class="hero-copy">
        <p class="kicker"><span></span> AUREL MAISON COLLECTION</p>
        <h1>Thời gian.<br /><em>Dấu ấn riêng.</em></h1>
        <p class="hero-description">Một chiếc đồng hồ, một câu chuyện. Khám phá những thiết kế dành cho từng dấu mốc của bạn.</p>
        <a class="button gold" asp-controller="DanhMuc" asp-action="Index">Khám phá bộ sưu tập <partial name="_Icon" model='@("arrow")' /></a>
        <a class="hero-link" asp-controller="Booking" asp-action="Index">Đặt lịch riêng tại Private Lounge <span>↗</span></a>
        <div class="hero-caption"><span>01 / COLLECTION</span><span>Đà Nẵng, Việt Nam</span></div>
    </div>
    <div class="hero-visual">
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="~/images/boutique-hero.jpg" aria-label="Video giới thiệu bộ sưu tập đồng hồ Aurel Maison">
            <source src="~/videos/aurel-maison-hero-15s.mp4" type="video/mp4" />
        </video>
        <aside class="live-caliber" aria-label="Cỗ máy thời gian trực tiếp theo giờ Đà Nẵng">
            <div class="live-caliber-face" aria-hidden="true">
                <svg viewBox="0 0 180 180" role="presentation">
                    <circle class="caliber-orbit" cx="90" cy="90" r="82" />
                    <circle class="caliber-track" cx="90" cy="90" r="68" />
                    <g class="caliber-gear caliber-gear-one"><circle cx="46" cy="63" r="19" /><path d="M46 40v5m0 36v5M23 63h5m36 0h5M30 47l4 4m24 24 4 4m0-32-4 4m-24 24-4 4" /></g>
                    <g class="caliber-gear caliber-gear-two"><circle cx="132" cy="111" r="25" /><path d="M132 82v5m0 48v5m-29-29h5m48 0h5m-49-20 4 4m34 34 4 4m0-42-4 4m-34 34-4 4" /></g>
                    <g class="caliber-ticks">
                        <path d="M90 19v7M90 154v7M19 90h7M154 90h7" />
                        <path d="M90 19v7M90 154v7M19 90h7M154 90h7" transform="rotate(30 90 90)" />
                        <path d="M90 19v7M90 154v7M19 90h7M154 90h7" transform="rotate(60 90 90)" />
                    </g>
                    <circle class="caliber-cage" cx="90" cy="90" r="35" />
                    <line class="caliber-hand caliber-hour" id="live-hour-hand" x1="90" y1="94" x2="90" y2="71" />
                    <line class="caliber-hand caliber-minute" id="live-minute-hand" x1="90" y1="94" x2="90" y2="54" />
                    <line class="caliber-hand caliber-second" id="live-second-hand" x1="90" y1="102" x2="90" y2="43" />
                    <circle class="caliber-pivot" cx="90" cy="90" r="3.5" />
                </svg>
            </div>
            <div class="live-caliber-meta"><span class="live-caliber-label">LIVE CALIBER · DA NANG</span><time id="danang-clock" datetime="">--:--:--</time><span class="live-caliber-rate">28,800 VPH · 8 BEATS / SEC</span></div>
        </aside>
        <span class="visual-label">THE ART OF KEEPING TIME</span>
    </div>
</section>
<section class="brand-strip" aria-label="Thương hiệu đồng hồ">
    <p class="kicker">NHỮNG TÊN TUỔI TRONG BỘ SƯU TẬP</p>
    <div class="brands">
    @foreach (var brand in Model.Hang)
    {
        var logoFile = brand.TenHang switch
        {
            "Audemars Piguet" => "audemars-piguet.svg",
            "Cartier" => "cartier.svg",
            "Jaeger-LeCoultre" => "jaeger-lecoultre.svg",
            "Omega" => "omega.svg",
            "Patek Philippe" => "patek-philippe.svg",
            "Rolex" => "rolex.svg",
            _ => ""
        };
        <a asp-controller="DanhMuc" asp-action="Index" asp-route-hang="@brand.MaHang" aria-label="Xem đồng hồ @brand.TenHang">
            @if (!string.IsNullOrEmpty(logoFile))
            {
                <img src="~/images/brands/@logoFile" alt="@brand.TenHang" loading="lazy" />
            }
            else
            {
                <span>@brand.TenHang</span>
            }
        </a>
    }
    </div>
</section>
<section class="section featured-section">
    <div class="section-heading">
        <div><p class="kicker">KHÁM PHÁ BỘ SƯU TẬP</p><h2>Thiết kế đáng chú ý</h2></div>
        <a class="text-link" asp-controller="DanhMuc" asp-action="Index">Xem tất cả đồng hồ <partial name="_Icon" model='@("arrow")' /></a>
    </div>
    <partial name="_Cards" model="Model.NoiBat" />
</section>
<section class="showroom-banner">
    <div class="showroom-number">AM<span>ĐÀ NẴNG</span></div>
    <div><p class="kicker">MỘT CUỘC HẸN DÀNH RIÊNG CHO BẠN</p><h2>Cảm nhận trên cổ tay.</h2><p>Chọn mẫu bạn yêu thích và đặt lịch xem trực tiếp. Mỗi chi tiết đều xứng đáng được cảm nhận.</p></div>
    <a class="button" asp-controller="Booking" asp-action="Index">Đặt lịch tại Private Lounge <partial name="_Icon" model='@("calendar")' /></a>
</section>
<div class="service-strip">
    <div><partial name="_Icon" model='@("clock")' /><span><strong>Khám phá theo cách của bạn</strong><small>Tìm theo hãng, loại máy và chất liệu</small></span></div>
    <div><partial name="_Icon" model='@("calendar")' /><span><strong>Hẹn gặp tại showroom</strong><small>Chọn mẫu và thời gian phù hợp</small></span></div>
    <div><partial name="_Icon" model='@("shield")' /><span><strong>Bảo hành luôn rõ ràng</strong><small>Tra cứu phiếu từ tài khoản của bạn</small></span></div>
</div>
